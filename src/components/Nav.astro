---
/**
 * Sticky site header for the marketing pages. The row itself (logo, section
 * links, Download button) lives in NavLinks.astro so the developer-docs header
 * (src/components/starlight/Header.astro) renders the same navigation.
 */
import NavLinks from './NavLinks.astro';

interface Props {
  hideBackdrop?: boolean;
}

const { hideBackdrop = false } = Astro.props;
---

<header
  class:list={[
    'sticky top-0 z-50 transition-colors',
    hideBackdrop ? 'bg-transparent' : 'bg-aerial-bg-deep/85 border-b border-aerial-border/50',
  ]}
  style="backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
>
  <NavLinks variant="site" />
</header>
